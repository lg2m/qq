// C1: A2 plus supervised write children. Requires a reviewer_model to
// adjudicate every mutating action a write child takes; without one the
// spawner refuses write authority and the arm degenerates to A2.
(
    version: 1,
    reviewer_model: "PROVIDER/REVIEWER",
    delegation: (
        roster: [
            (route: "PROVIDER/FAST", role: fast, note: "lookups, breadth"),
            (route: "PROVIDER/PRIMARY", role: balanced),
        ],
        default_role: fast,
        max_depth: 1,
        write_children: true,
    ),
    audit: (mode: off),
)
