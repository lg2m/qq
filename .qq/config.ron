(
    policy: (
        allow_tools: [
            "edit_file",
        ],
        allow_shell_prefixes: [
            "git status --short && git diff --stat",
            "cargo fmt --all && cargo check --workspace",
            "cargo fmt --all -- --check && cargo check --workspace",
        ],
    ),
    version: 1,
    model: "openai-codex/gpt-5.6-luna",
    providers: {
        "bedrock": AmazonBedrock(
            region: "us-east-1",
            auth: ApiKey(Stored("bedrock/default")),
        ),
        "bedrock-mantle": AmazonBedrockMantle(
            region: "us-east-1",
            api: AnthropicMessages,
            auth: ApiKey(Stored("bedrock/default")),
        ),
    },
    mcp: {
        "executor": Http(
            url: "https://executor.sh/lg2m/mcp",
            allow: [
                "execute",
                "skills",
                "resume",
            ],
            eager: true,
        ),
    },
)
