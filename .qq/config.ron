(
    version: 1,
    model: "bedrock-mantle/anthropic.claude-sonnet-5",
    providers: {
        "bedrock": AmazonBedrock(
            region: "us-east-1",
            auth: ApiKey(Stored("bedrock/default")),
        ),
        "bedrock-mantle": AmazonBedrockMantle(
            region: "us-east-1",
            api: AnthropicMessages,
            auth: ApiKey(Stored("bedrock/default")),
        ),
    },
    mcp: {
        "executor": Http(
            url: "https://executor.sh/lg2m/mcp",
            // optional bearer if the endport requires one:
            // bearer: Env("EXECUTOR_TOKEN"),
            // or: bearer: Stored("executor/default"),
            allow: ["execute", "skills", "resume"],
            eager: true, // connect at startup instead of first use
        )
    },
)
