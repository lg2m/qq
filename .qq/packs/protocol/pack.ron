(
    schema: 1,
    id: "protocol",
    version: "0.1.0",
    name: "QQ protocol and persistence engineer",
    requires: (protocol: 14),
    profiles: {
        // Edits wire types, descriptors, schemas, and their goldens and docs.
        // Regenerating fixtures needs shell; every regeneration is inspected.
        "protocol": (
            approval_mode: ask,
            max_output_tokens: 16384,
            prompt: "prompts/persona.md",
            skills: ["skills"],
            tools: (
                deny: ["spawn_agent", "mcp__*"],
            ),
            mcp: [],
        ),
    },
)
