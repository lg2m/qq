(
    schema: 1,
    id: "reviewer",
    version: "0.1.0",
    name: "QQ code reviewer",
    requires: (protocol: 14),
    profiles: {
        // Read-only by construction: the mutating built-ins are removed from
        // the catalog, so the model cannot even see them. Reviews are
        // reports, not patches.
        "reviewer": (
            approval_mode: read_only,
            prompt: "prompts/persona.md",
            skills: ["skills"],
            tools: (
                deny: ["shell", "write_file", "edit_file", "spawn_agent", "mcp__*"],
            ),
            mcp: [],
        ),
    },
)
