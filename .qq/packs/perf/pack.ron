(
    schema: 1,
    id: "perf",
    version: "0.1.0",
    name: "QQ performance engineer",
    requires: (protocol: 14),
    profiles: {
        // Measures before and after, edits code, and writes receipts. Needs
        // shell for cargo bench and xtask perf; mutating tools stay behind
        // the Ask approval mode rather than a policy deny.
        "perf": (
            approval_mode: ask,
            max_output_tokens: 16384,
            prompt: "prompts/persona.md",
            skills: ["skills"],
            tools: (
                deny: ["spawn_agent", "mcp__*"],
            ),
            mcp: [],
        ),
    },
)
