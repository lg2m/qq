// Dracula. Palette: draculatheme.com/spec.
//
// Purple is the accent, orange the brand, and the spec's opaque selection
// tone is the code surface so it sits one step above the background.
(
    version: 1,
    defs: {
        "foreground": "#f8f8f2",
        "comment":    "#6272a4",
        "purple":     "#bd93f9",
        "orange":     "#ffb86c",
        "yellow":     "#f1fa8c",
        "red":        "#ff5555",
        "green":      "#50fa7b",
        "selection":  "#44475a",
    },
    colors: (
        text:    "foreground",
        muted:   "comment",
        accent:  "purple",
        brand:   "orange",
        warning: "yellow",
        error:   "red",
        success: "green",
        surface: "selection",
    ),
)
